  {"rule": "vacation_pay_average_months", "value": 6, "status": "found", "source": "CCT", "article": "art. 30.1", "note": "Moyenne des salaires bruts des six derniers mois complets quand la rémunération contient une participation au chiffre d'affaires."},
  {"rule": "vacation_pay_excluded", "value": "Primes, provisions sur les ventes et gratifications", "status": "found", "source": "CCT", "article": "art. 30.1"},
