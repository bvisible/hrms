{# //// Neoffice — added file (no upstream equivalent): the template of /sitemap_jobs.xml (neoffice-maintenance#1294). #}<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for link in links %}
	<url>
		<loc>{{ link.loc | e }}</loc>
		{%- if link.lastmod %}
		<lastmod>{{ link.lastmod }}</lastmod>
		{%- endif %}
	</url>
{%- endfor %}
</urlset>
