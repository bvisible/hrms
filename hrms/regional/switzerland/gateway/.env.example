# SwissDecTX CLI path (local)
SWISSDECTX_PATH=C:\Program Files (x86)\SwissDecTX5\SwissDecTX.exe

# Working directory for TX files
SWISSDEC_WORK_DIR=C:\SwissDec\tx

# API authentication (comma-separated keys)
SWISSDEC_API_KEYS=your-api-key-1,your-api-key-2

# Local storage for transmission results
SWISSDEC_STORAGE_DIR=C:\SwissDec\transmissions

# TX command timeout in seconds
SWISSDEC_TX_TIMEOUT=120
