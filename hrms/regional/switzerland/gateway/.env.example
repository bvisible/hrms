# SwissDecTX VM connection
SWISSDEC_VM_HOST=192.168.20.103
SWISSDEC_VM_PORT=22
SWISSDEC_VM_USER=Neoservice
SWISSDEC_VM_SSH_KEY=/var/services/homes/Neoservice/.ssh/id_rsa

# SwissDecTX CLI path on the VM
SWISSDECTX_PATH=C:\Program Files (x86)\SwissDecTX5\SwissDecTX.exe
SWISSDEC_VM_WORK_DIR=C:\swissdec\tx

# API authentication (comma-separated keys)
SWISSDEC_API_KEYS=your-api-key-1,your-api-key-2

# Local storage for transmission files
SWISSDEC_STORAGE_DIR=/volume1/SwissDec/transmissions

# TX command timeout in seconds
SWISSDEC_TX_TIMEOUT=120
